# Local development only. Use a secret manager and strong rotated values in production.
POSTGRES_USER=reminder
POSTGRES_PASSWORD=change-me-for-production
POSTGRES_DB=reminder_app
DATABASE_URL=postgresql+asyncpg://reminder:change-me-for-production@postgres:5432/reminder_app
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:1420,http://tauri.localhost,tauri://localhost
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Initial administrator bootstrap. Used only when this email does not already exist.
# Replace these before the first startup. Do not use development values in production.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_ADMIN_NAME=System Administrator
